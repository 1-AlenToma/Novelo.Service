<Window
    x:Class="ExpressServiceControlPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Novelo Server Control Panel"
    Height="700" Width="900"
    Background="{DynamicResource MaterialDesignPaper}" Icon="/icon.ico">

    <Grid>
        <Border Background="White"
                CornerRadius="20"
                Padding="24"
                Margin="50"
                SnapsToDevicePixels="True">
            <DockPanel LastChildFill="True" >

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" x:Name="lblRootPath" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,20,0" Text="rootPath" FontSize="15"/>
                        <CheckBox Grid.Column="0" x:Name="ChkLogSql"
                     Content="Enable SQL Logging"
                     FontSize="15"
                     Style="{StaticResource MaterialDesignCheckBox}"
                     Margin="0,0,0,0"
                      />
                       
                    </Grid>
                </StackPanel>
                <!-- Form Controls -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" HorizontalAlignment="Center" Width="550">
                    <StackPanel x:Name="stkPort" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                        <TextBox x:Name="TxtPort"
                                 Width="100"
                                 FontSize="15"
                                 TextAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,10,0"/>
                        <Button x:Name="BtnSave"
                                Content="Save"
                                Width="90"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="BtnSave_Click"/>
                    </StackPanel>

                    <TextBox x:Name="LblStatus"
                               Text="Loading..."
                               FontSize="13"
                               Foreground="#555"
                               BorderThickness="0"
                               Background="Transparent"
                               IsReadOnly="True"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="BtnInstall"
                                Content="Install Service"
                                Width="160"
                                Margin="0,0,10,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="BtnInstall_Click"/>
                        <Button x:Name="BtnUninstall"
                                Content="Uninstall Service"
                                Width="160"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="BtnUninstall_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="LblServiceStatus"
                               Text=""
                               FontSize="14"
                               Foreground="#333"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Console -->
                <DockPanel x:Name="pre" DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- For label -->
                            <RowDefinition Height="*"/>
                            <!-- For ScrollViewer -->
                        </Grid.RowDefinitions>
                        <TextBlock Text="Server Console:"
                                   Grid.Row="0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,10,0,8"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Grid.Row="1"
                                      Background="#1e1e1e"
                                      Padding="10">
                            <StackPanel x:Name="ConsolePanel"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
